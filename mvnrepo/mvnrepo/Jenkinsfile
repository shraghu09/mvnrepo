
pipeline {
    agent any

    stages {
        stage('Inspect Workspace') {
            steps {
                sh 'echo "Workspace:"'
                sh 'pwd'
                sh 'ls -la'
                sh 'find . -maxdepth 6 -name pom.xml'
                sh 'java -version'
                sh 'mvn -version'
                sh 'docker --version'
            }
        }
    }
}
