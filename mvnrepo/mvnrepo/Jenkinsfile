
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Inspect Project') {
            steps {
                sh 'pwd'
                sh 'ls -la mvnrepo/mvnrepo'
            }
        }

       
stage('Build Java WAR') {
    steps {
        dir('mvnrepo/mvnrepo/backend') {
            sh '''
                echo "Checking Java and Maven"
                java -version
                mvn -version

                echo "Checking compiler"
                javac -version
                which javac

                echo "Building WAR"
                mvn -B clean package
                ls -lh target/
            '''
        }
    }
}


        stage('Build Docker Image') {
            steps {
                sh 'docker build -t mvnrepo-backend:${BUILD_NUMBER} mvnrepo/mvnrepo/backend'
            }
        }
    }

    post {
        success {
            echo 'Java WAR built and Docker image created successfully.'
        }
        failure {
            echo 'Build failed. Check Console Output for the error.'
        }
    }
}
