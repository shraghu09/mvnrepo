
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Java WAR') {
            steps {
                dir('mvnrepo/mvnrepo/backend') {
                    sh '''
                        docker run --rm \
                          -v "$PWD":/app \
                          -w /app \
                          maven:3.9-eclipse-temurin-17 \
                          mvn -B clean package

                        ls -lh target/
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t mvnrepo-backend:${BUILD_NUMBER} mvnrepo/mvnrepo/backend'
            }
        }
    }

    post {
        success {
            echo 'Java WAR built and Docker image created successfully.'
        }
        failure {
            echo 'Build failed. Check Console Output.'
        }
    }
}
